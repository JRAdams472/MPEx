# MPEx env — copy to `.env` and fill in real values. `.env` is gitignored;
# never commit secrets. `docker compose` reads `.env` for ${VAR} interpolation
# and fails closed on any unset ${VAR:?} secret below.
#
# Generate secrets with: openssl rand -hex 32

# --- Secrets (required — no defaults) ---
POSTGRES_PASSWORD=
DEX_MPEX_SVC_SECRET=
DEX_MPEX_CI_SECRET=
SESSION_SECRET=
# Seq admin (first boot only) — salted hash, not plaintext:
#   echo 'your-password' | docker run --rm -i datalust/seq config hash
# Then create an ingest API key via seqcli/UI for SEQ_API_KEY. docs/security.md.
SEQ_ADMIN_PASSWORD_HASH=
SEQ_API_KEY=

# --- API ---
DATABASE_URL=postgres://mpex:__POSTGRES_PASSWORD__@localhost:5432/mpex
PORT=8080
RUST_LOG=info,mpex=debug,tower_http=info
CORS_ORIGIN=http://localhost:3000

# OIDC resource-server settings. With OIDC_ISSUER unset the API runs with no
# auth context (dev convenience); whoami then returns 500.
OIDC_ISSUER=http://localhost:5556/dex
# Accepted `aud` values, comma-separated: dex stamps aud with the client_id
# (mpex-web UI, mpex-svc service, mpex-ci automation — all client-credentials).
OIDC_AUDIENCE=mpex-api,mpex-web,mpex-svc,mpex-ci
# Optional: where to fetch JWKS when it differs from the issuer's public URL
# (e.g. inside compose: http://dex:5556/dex/keys). Unset = OIDC discovery.
OIDC_JWKS_URL=

# --- Observability (optional; unset = stdout JSON only) ---
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# SEQ_URL=http://localhost:5341/ingest/otlp/v1/logs

# --- Web BFF (server-side) ---
# Browser never calls the API directly — /bff attaches the session token.
API_URL=http://localhost:8080
OIDC_CLIENT_ID=mpex-web
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
OIDC_TOKEN_URL=http://localhost:5556/dex/token
# SESSION_SECURE=1  # set for https deployments
