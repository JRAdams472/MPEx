DATABASE_URL=postgres://mpex:mpex@localhost:5432/mpex
PORT=8080
RUST_LOG=info,mpex=debug,tower_http=info
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080

# OIDC resource-server settings. With OIDC_ISSUER unset the API runs with no
# auth context (dev convenience); whoami then returns 500.
OIDC_ISSUER=http://localhost:5556/dex
# Accepted `aud` values, comma-separated: dex stamps aud with the client_id
# (mpex-web for UI tokens, mpex-svc for client-credentials service tokens).
OIDC_AUDIENCE=mpex-api,mpex-web,mpex-svc
# Optional: where to fetch JWKS when it differs from the issuer's public URL
# (e.g. inside compose: http://dex:5556/dex/keys). Unset = OIDC discovery.
OIDC_JWKS_URL=

# Dev IdP (dex/config.dev.yaml) — secret for the mpex-svc client-credentials
# client. Dev default only; real deployments inject a real secret.
DEX_MPEX_SVC_SECRET=mpex-svc-dev-secret
