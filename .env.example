DATABASE_URL=postgres://mpex:mpex@localhost:5432/mpex
PORT=8080
RUST_LOG=info,mpex=debug,tower_http=info
CORS_ORIGIN=http://localhost:3000
# Web BFF (server-side): API proxy target + OIDC client settings.
# Browser never calls the API directly — /bff attaches the session token.
API_URL=http://localhost:8080
OIDC_CLIENT_ID=mpex-web
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
OIDC_TOKEN_URL=http://localhost:5556/dex/token
SESSION_SECRET=mpex-dev-session-secret-change-me
# SESSION_SECURE=1  # set for https deployments

# OIDC resource-server settings. With OIDC_ISSUER unset the API runs with no
# auth context (dev convenience); whoami then returns 500.
OIDC_ISSUER=http://localhost:5556/dex
# Accepted `aud` values, comma-separated: dex stamps aud with the client_id
# (mpex-web UI, mpex-svc service, mpex-ci automation — all client-credentials).
OIDC_AUDIENCE=mpex-api,mpex-web,mpex-svc,mpex-ci
# Optional: where to fetch JWKS when it differs from the issuer's public URL
# (e.g. inside compose: http://dex:5556/dex/keys). Unset = OIDC discovery.
OIDC_JWKS_URL=

# Dev IdP (dex/config.dev.yaml) — secrets for the client-credentials clients.
# Dev defaults only; real deployments inject real secrets.
DEX_MPEX_SVC_SECRET=mpex-svc-dev-secret
DEX_MPEX_CI_SECRET=mpex-ci-dev-secret
